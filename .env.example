# Application
NODE_ENV=development
PORT=3010

# Database

# 73 VELAS SUBIDA
#DATABASE_URI=mongodb://localhost:27017/data-analyser

# Data rota, 90 velas
#DATABASE_URI=mongodb://localhost:27017/crypto-data-analyser-v2

#Data rota, 10 velas
#DATABASE_URI=mongodb://localhost:27017/crypto-data-analyser-v3

#Actual
DATABASE_URI=mongodb://localhost:27017/crypto-data-analyser-v4


# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600s

# CORS
CORS_ORIGIN=*

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=-

# Swagger
SWAGGER_TITLE=DATA ANALYSER
SWAGGER_DESCRIPTION=A comprehensive NestJS boilerplate with MongoDB, Redis, JWT Auth, and Generic CRUD Service
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs


ANALYSER_PRINT_PREV_CLOSE=true   # Mostrar precio anterior
ANALYSER_PRINT_TIMES=true        # Mostrar tHigh/tLow

TRADING_MODE=simulation          # simulation o live

TRADING_CAPITAL=400              # USD
TRADING_LEVERAGE=10              # 10x

TRADING_TP1_SPLIT=0.5           # 50% en TP1
TRADING_TP2_SPLIT=0.5           # 50% en TP2
TRADING_SL_PCT=0.0015           # 0.15% SL
TRADING_TP1_PCT=0.002           # 0.20% TP1
TRADING_TP2_PCT=0.0045          # 0.45% TP2

TRADING_SPREAD_MAX=0.0005       # 0.05% spread máx
TRADING_SLIPPAGE_MAX=0.0003     # 0.03% slippage máx
TRADING_VOL_MAX=0.5             # 0.5% volatilidad máx
TRADING_RR_MIN=1.5              # R/R mínimo

TRADING_THROTTLE_MINUTES=5
TRADING_STRICT_RETEST=true
TRADING_ALLOW_PYRAMIDING=false

READY_FOR_ANALYSIS_PREFIX_TOPIC = READY_FOR_ANALYSIS

# Binance API Configuration
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com


DB_LABORATORY_NAME = data-analyser

SCAN_SINGLE=false
SCAN_DOUBLE=false
SCAN_TRIPLE=true
SCAN_CHART=false

# Maximum quantity of candles to process (0 or 'Infinity' = all candles)
MAX_QTY=5000
