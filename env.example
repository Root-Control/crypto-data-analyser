# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URI=mongodb://localhost:27017/new-tes

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600s

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_TITLE=New TES API
SWAGGER_DESCRIPTION=A comprehensive NestJS boilerplate with MongoDB, Redis, JWT Auth, and Generic CRUD Service
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs

# Pin Volume Reversal Strategy Settings
PIN_VOLUME_REVERSAL_VOL_BASIS=SMA-10
PIN_VOLUME_REVERSAL_CONFIRM_NEXT=false
PIN_VOLUME_REVERSAL_VOLUME_MULT=2.0

# Testing
TEST_MODE=false
