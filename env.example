# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URI=mongodb://localhost:27017/crypto-analyser

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600s

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_TITLE=Crypto Data Analyser API
SWAGGER_DESCRIPTION=Sistema de análisis de criptomonedas con trading automático
SWAGGER_VERSION=2.0
SWAGGER_PATH=docs

# ========================================
# ANALYSER SERVICE
# ========================================
# Mostrar PrevClose en logs (default: true)
ANALYSER_PRINT_PREV_CLOSE=true

# Mostrar tHigh/tLow en logs (default: true)
ANALYSER_PRINT_TIMES=true

# ========================================
# TRADING ORCHESTRATOR
# ========================================
# Modo de operación: simulation | live
TRADING_MODE=simulation

# Binance API (solo para modo live)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Capital y Apalancamiento
TRADING_CAPITAL=100
TRADING_LEVERAGE=10

# TP/SL Configuración
TRADING_TP1_SPLIT=0.5       # 50% en TP1
TRADING_TP2_SPLIT=0.5       # 50% en TP2
TRADING_SL_PCT=0.0015       # 0.15% Stop Loss
TRADING_TP1_PCT=0.002       # 0.20% Take Profit 1
TRADING_TP2_PCT=0.0045      # 0.45% Take Profit 2

# Límites de Seguridad
TRADING_SPREAD_MAX=0.0005   # 0.05% spread máximo
TRADING_SLIPPAGE_MAX=0.0003 # 0.03% slippage máximo
TRADING_VOL_MAX=0.5         # 0.5% volatilidad máxima
TRADING_RR_MIN=1.5          # Risk/Reward mínimo 1.5

# Control de Ejecución
TRADING_THROTTLE_MINUTES=5
TRADING_STRICT_RETEST=true
TRADING_ALLOW_PYRAMIDING=false

# Exchange Info (ETHUSDT Binance Futures)
TRADING_TICK_SIZE=0.01
TRADING_STEP_SIZE=0.001

# Testing
TEST_MODE=false

# ========================================
# PREDICTIONS SERVICE
# ========================================
# Tópico de Redis para análisis listo (default: READY_FOR_ANALYSIS)
READY_FOR_ANALYSIS_PREFIX_TOPIC=READY_FOR_ANALYSIS
